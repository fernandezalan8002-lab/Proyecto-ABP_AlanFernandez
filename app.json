{
  "expo": {
    "name": "Mesa de Ayuda",
    "slug": "mesa-de-ayuda-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mesadeayuda",
    "splash": {
      "backgroundColor": "#1B2A4A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A4A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
